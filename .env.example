# إعدادات الاتصال بالسيرفر.
# انسخ هذا الملف إلى .env وعدّله حسب بيئتك:  cp .env.example .env
#
# API_HOST اتركه فارغاً ليختار التطبيق تلقائياً:
#   10.0.2.2  على محاكي أندرويد (هو عنوان جهازك من داخل المحاكي)
#   localhost على سطح المكتب والويب
# وعلى جوال حقيقي ضع عنوان كمبيوترك على الشبكة، مثل 192.168.100.67
API_HOST=
API_PORT=8000

# Reverb — القناة الحيّة. اترك REVERB_HOST فارغاً ليتبع API_HOST.
REVERB_HOST=
REVERB_PORT=8090
REVERB_TLS=false

# المفتاح العام لـ Reverb (ليس السر) — يطابق REVERB_APP_KEY في سيرفر Laravel.
REVERB_KEY=rmm5o8e10zeqbgpep91e
